# Environment variables for local development
# Copy this file to .env and update with your values

# For local laptop development, use localhost
DOMAIN=

# Optional public URL for a single-domain reverse proxy:
# DOMAIN=https://photos.example.com

# Legacy split-domain deployments remain supported:
# FRONTEND_DOMAIN=https://photos.example.com
# BACKEND_DOMAIN=https://api.example.com

# Optional internal backend address for separate containers (default shown):
# BACKEND_INTERNAL_URL=http://127.0.0.1:3001

# For dev server, use:
# FRONTEND_DOMAIN=https://www-dev.example.net
# BACKEND_DOMAIN=https://api-dev.example.net

# For prod server, use:
# FRONTEND_DOMAIN=https://www.example.net
# BACKEND_DOMAIN=https://api.example.net

# Data directory (optional, defaults to ./data)
# DATA_DIR=./data

# Logging level (optional, defaults to 'error')
# Options: silent, error, warn, info, debug, verbose, trace
# Now controlled via Admin UI (Settings → Advanced Settings → Logging)
# Stored in config.json - uncomment to override UI settings
# LOG_LEVEL=info

# OpenAI API Key (for auto-translate script and AI title generation)
# Get your key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-api-key-here
